{
  "$defs": {
    "PublicationProvenance": {
      "additionalProperties": false,
      "properties": {
        "analysis_completed_at": {
          "format": "date-time",
          "title": "Analysis Completed At",
          "type": "string"
        },
        "analysis_started_at": {
          "format": "date-time",
          "title": "Analysis Started At",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "model_revisions": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Model Revisions",
          "type": "object"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "analysis_started_at",
        "analysis_completed_at",
        "source_commit",
        "config_sha256",
        "model_revisions"
      ],
      "title": "PublicationProvenance",
      "type": "object"
    },
    "PublishedArticle": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "domain": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "source_name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "word_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Count"
        }
      },
      "required": [
        "id",
        "source_name",
        "title",
        "url",
        "domain"
      ],
      "title": "PublishedArticle",
      "type": "object"
    },
    "PublishedClaim": {
      "additionalProperties": false,
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        },
        "verdict_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict Probability"
        }
      },
      "required": [
        "id",
        "article_id",
        "text",
        "extracted_at"
      ],
      "title": "PublishedClaim",
      "type": "object"
    },
    "PublishedRelationship": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "from_claim_id": {
          "format": "uuid",
          "title": "From Claim Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "relationship_type": {
          "enum": [
            "SIMILAR_TO",
            "EVOLVED_FROM"
          ],
          "title": "Relationship Type",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "to_claim_id": {
          "format": "uuid",
          "title": "To Claim Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from_claim_id",
        "to_claim_id",
        "relationship_type",
        "score",
        "created_at"
      ],
      "title": "PublishedRelationship",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "articles": {
      "items": {
        "$ref": "#/$defs/PublishedArticle"
      },
      "maxItems": 20000,
      "title": "Articles",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/PublishedClaim"
      },
      "maxItems": 50000,
      "title": "Claims",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/PublicationProvenance"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/PublishedRelationship"
      },
      "maxItems": 100000,
      "title": "Relationships",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "provenance",
    "articles",
    "claims",
    "relationships"
  ],
  "title": "PublicationSnapshot",
  "type": "object"
}
