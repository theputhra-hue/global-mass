{
  "$defs": {
    "ArticleAssignment": {
      "additionalProperties": false,
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "basis": {
          "enum": [
            "stored_text",
            "title_only",
            "unsupported_language",
            "unavailable"
          ],
          "title": "Basis",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "topic_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": -100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": -100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "article_id",
        "basis"
      ],
      "title": "ArticleAssignment",
      "type": "object"
    },
    "ArticleMap": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/ArticleAssignment"
          },
          "maxItems": 20000,
          "title": "Assignments",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "embedding_model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Embedding Revision",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "method": {
          "const": "article-bertopic-umap-v1",
          "default": "article-bertopic-umap-v1",
          "title": "Method",
          "type": "string"
        },
        "projection": {
          "const": "umap_cosine_2d",
          "default": "umap_cosine_2d",
          "title": "Projection",
          "type": "string"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/ArticleTopic"
          },
          "maxItems": 2000,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "source_commit",
        "input_sha256",
        "config_sha256",
        "embedding_model",
        "embedding_revision",
        "seed",
        "topics",
        "assignments"
      ],
      "title": "ArticleMap",
      "type": "object"
    },
    "ArticleTopic": {
      "additionalProperties": false,
      "properties": {
        "article_count": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Article Count",
          "type": "integer"
        },
        "id": {
          "maxLength": 40,
          "pattern": "^topic-[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Keywords",
          "type": "array"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "keywords",
        "article_count"
      ],
      "title": "ArticleTopic",
      "type": "object"
    },
    "CityNetwork": {
      "additionalProperties": false,
      "properties": {
        "article_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20000,
          "title": "Article Ids",
          "type": "array"
        },
        "calibration": {
          "const": "exploratory_not_human_validated",
          "default": "exploratory_not_human_validated",
          "title": "Calibration",
          "type": "string"
        },
        "community_method": {
          "const": "networkx_louvain",
          "default": "networkx_louvain",
          "title": "Community Method",
          "type": "string"
        },
        "community_revision": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Community Revision",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "embedding_model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Embedding Revision",
          "type": "string"
        },
        "highways": {
          "items": {
            "$ref": "#/$defs/Highway"
          },
          "maxItems": 20000,
          "title": "Highways",
          "type": "array"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "method": {
          "const": "mutual-cosine-city-v1",
          "default": "mutual-cosine-city-v1",
          "title": "Method",
          "type": "string"
        },
        "min_highway_endpoints": {
          "maximum": 20,
          "minimum": 1,
          "title": "Min Highway Endpoints",
          "type": "integer"
        },
        "min_highway_support": {
          "maximum": 100,
          "minimum": 1,
          "title": "Min Highway Support",
          "type": "integer"
        },
        "min_similarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Min Similarity",
          "type": "number"
        },
        "neighbor_k": {
          "maximum": 20,
          "minimum": 1,
          "title": "Neighbor K",
          "type": "integer"
        },
        "roads": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "maximum": 19999,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 19999,
                "minimum": 0,
                "type": "integer"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 100000,
          "title": "Roads",
          "type": "array"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        },
        "source_map_run_id": {
          "format": "uuid",
          "title": "Source Map Run Id",
          "type": "string"
        },
        "source_map_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Map Sha256",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "superways": {
          "items": {
            "$ref": "#/$defs/Superway"
          },
          "maxItems": 20000,
          "title": "Superways",
          "type": "array"
        },
        "themes": {
          "items": {
            "$ref": "#/$defs/CityTheme"
          },
          "maxItems": 2000,
          "title": "Themes",
          "type": "array"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "source_commit",
        "source_map_run_id",
        "source_map_sha256",
        "input_sha256",
        "config_sha256",
        "embedding_model",
        "embedding_revision",
        "community_revision",
        "seed",
        "neighbor_k",
        "min_similarity",
        "min_highway_support",
        "min_highway_endpoints",
        "article_ids",
        "roads",
        "highways",
        "themes",
        "superways"
      ],
      "title": "CityNetwork",
      "type": "object"
    },
    "CityTheme": {
      "additionalProperties": false,
      "properties": {
        "article_count": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Article Count",
          "type": "integer"
        },
        "id": {
          "maxLength": 40,
          "pattern": "^theme-[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "topics",
        "article_count"
      ],
      "title": "CityTheme",
      "type": "object"
    },
    "Highway": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "endpoints_a": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Endpoints A",
          "type": "integer"
        },
        "endpoints_b": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Endpoints B",
          "type": "integer"
        },
        "support": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Support",
          "type": "integer"
        }
      },
      "required": [
        "a",
        "b",
        "support",
        "endpoints_a",
        "endpoints_b"
      ],
      "title": "Highway",
      "type": "object"
    },
    "PublicationProvenance": {
      "additionalProperties": false,
      "properties": {
        "analysis_completed_at": {
          "format": "date-time",
          "title": "Analysis Completed At",
          "type": "string"
        },
        "analysis_started_at": {
          "format": "date-time",
          "title": "Analysis Started At",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "model_revisions": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Model Revisions",
          "type": "object"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "analysis_started_at",
        "analysis_completed_at",
        "source_commit",
        "config_sha256",
        "model_revisions"
      ],
      "title": "PublicationProvenance",
      "type": "object"
    },
    "PublishedArticle": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "domain": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "source_name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "word_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Count"
        }
      },
      "required": [
        "id",
        "source_name",
        "title",
        "url",
        "domain"
      ],
      "title": "PublishedArticle",
      "type": "object"
    },
    "PublishedClaim": {
      "additionalProperties": false,
      "properties": {
        "article_id": {
          "format": "uuid",
          "title": "Article Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        },
        "verdict_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict Probability"
        }
      },
      "required": [
        "id",
        "article_id",
        "text",
        "extracted_at"
      ],
      "title": "PublishedClaim",
      "type": "object"
    },
    "PublishedRelationship": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "from_claim_id": {
          "format": "uuid",
          "title": "From Claim Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "relationship_type": {
          "enum": [
            "SIMILAR_TO",
            "EVOLVED_FROM"
          ],
          "title": "Relationship Type",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "to_claim_id": {
          "format": "uuid",
          "title": "To Claim Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from_claim_id",
        "to_claim_id",
        "relationship_type",
        "score",
        "created_at"
      ],
      "title": "PublishedRelationship",
      "type": "object"
    },
    "Superway": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "highways": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Highways",
          "type": "integer"
        },
        "support": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Support",
          "type": "integer"
        }
      },
      "required": [
        "a",
        "b",
        "support",
        "highways"
      ],
      "title": "Superway",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "articles": {
      "items": {
        "$ref": "#/$defs/PublishedArticle"
      },
      "maxItems": 20000,
      "title": "Articles",
      "type": "array"
    },
    "city_network": {
      "anyOf": [
        {
          "$ref": "#/$defs/CityNetwork"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/PublishedClaim"
      },
      "maxItems": 50000,
      "title": "Claims",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/PublicationProvenance"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/PublishedRelationship"
      },
      "maxItems": 100000,
      "title": "Relationships",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "enum": [
        "1",
        "2",
        "3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "topic_map": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArticleMap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "provenance",
    "articles",
    "claims",
    "relationships"
  ],
  "title": "PublicationSnapshot",
  "type": "object"
}
